{% extends "base.jinja2" %}
{% block title %}Forgot password{% endblock %}
{% block content %}
<h1>Forgot password</h1>
<p>Enter your email address. If it belongs to an account, a reset link will be logged by this development example.</p>
<form method="post" action="/forgot-password">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div><label>Email <input type="email" name="email" value="{{ form.email|default('') }}" required></label></div>
    <button type="submit">Request reset link</button>
</form>
{% endblock %}
