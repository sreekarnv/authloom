{% extends "base.jinja2" %}
{% block title %}Forgot password{% endblock %}
{% block content %}
<div class="row justify-content-center">
<div class="col-12 col-md-8 col-lg-5">
<h1 class="mb-4">Forgot password</h1>
<p class="text-body-secondary">Enter your email address to request a reset link.</p>
<form method="post" action="/forgot-password" class="vstack gap-3">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div>
        <label for="email" class="form-label">Email</label>
        <input id="email" class="form-control" type="email" name="email" value="{{ form.email|default('') }}" required>
    </div>
    <button type="submit" class="btn btn-primary">Request reset link</button>
</form>
</div>
</div>
{% endblock %}
