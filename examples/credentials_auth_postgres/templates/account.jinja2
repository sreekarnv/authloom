{% extends "base.jinja2" %}
{% block title %}Account{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Account</h1>
    <span class="badge {% if user.email_verified_at %}text-bg-success{% else %}text-bg-warning{% endif %}">
        {% if user.email_verified_at %}Email verified{% else %}Email not verified{% endif %}
    </span>
</div>
<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">{{ user.name }}</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">{{ user.email }}</dd>
</dl>

{% if not user.email_verified_at %}
<form method="post" action="/account/email-verification" class="mb-3">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="btn btn-outline-primary">Request verification link</button>
</form>
{% endif %}

<a class="btn btn-secondary" href="/account/password">Change password</a>
{% endblock %}
